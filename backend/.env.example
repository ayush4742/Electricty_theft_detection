# ---------------------------------------------------------------------------
# Electricity Theft Detection - SMS alert configuration
#
# Copy this file to backend/.env and fill in your real values:
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# backend/.env is git-ignored. NEVER commit it and never paste real
# credentials into any .py or .jsx file.
# ---------------------------------------------------------------------------

# Master switch for the whole alerting feature (true / false)
SMS_ALERTS_ENABLED=true

# Which provider to use: telegram | twilio | fast2sms | console | disabled
#   telegram - free phone notifications via a Telegram bot (no billing, no DLT)
#   twilio   - real SMS via Twilio (cannot deliver to Indian numbers on a
#              normal Twilio long code)
#   fast2sms - real SMS via Fast2SMS (needs a one-time 100 INR recharge before
#              the API route is unlocked)
#   console  - nothing is sent, the message is printed to the backend log
#              (use this for offline demos and while testing)
#   disabled - alerting is switched off
SMS_PROVIDER=telegram

# --- Telegram (only needed when SMS_PROVIDER=telegram) ---------------------
# 1. Message @BotFather on Telegram and send /newbot
# 2. Paste the token it gives you below
# 3. Send your new bot any message, then run: python get_telegram_chat_id.py
# 4. Paste the chat id it prints below (comma separated for several people)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_IDS=your_chat_id

# --- Twilio credentials (only needed when SMS_PROVIDER=twilio) --------------
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# --- Fast2SMS (only needed when SMS_PROVIDER=fast2sms) ----------------------
FAST2SMS_API_KEY=your_fast2sms_api_key

# --- Where alerts are delivered --------------------------------------------
# Used by twilio / fast2sms / console. Telegram uses TELEGRAM_CHAT_IDS instead.
#   twilio   - E.164 format with country code: +919876543210
#   fast2sms - 10 digits, no country code:     9876543210
# Comma separate for several recipients.
# On a Twilio trial account every number here must first be verified.
ALERT_PHONE_NUMBERS=your_destination_number

# --- Spam protection --------------------------------------------------------
# Do not text about the same meter more than once per this many minutes.
ALERT_COOLDOWN_MINUTES=60

# Largest number of individual SMS a single CSV upload may send. Any remaining
# theft meters are reported in the batch summary SMS instead.
MAX_ALERTS_PER_BATCH=10

# Send one summary SMS at the end of every CSV upload that found theft.
BATCH_SUMMARY_ENABLED=true

# Ignore theft predictions below this confidence percentage (0 = alert on all).
ALERT_MIN_CONFIDENCE=0

# --- Test endpoint protection ----------------------------------------------
# POST /test-alert only works when this is set, and the caller must send the
# same value in the X-Alert-Token header. Leave blank to disable the endpoint.
# Use any long random string, e.g. the output of:  python -c "import secrets;print(secrets.token_urlsafe(24))"
ALERT_TEST_TOKEN=choose_a_long_random_string

# Minimum seconds between two test messages.
TEST_ALERT_COOLDOWN_SECONDS=300


# ---------------------------------------------------------------------------
# AI assistant
#
# The assistant answers questions by calling tools that query this project's
# own database. It is never allowed to state a number it did not get from a
# tool, which is what stops it inventing confident nonsense.
# ---------------------------------------------------------------------------

# Which brain to use: ollama | rules | disabled
#   ollama   - a model running locally via Ollama. Free, works offline, and no
#              consumer billing data ever leaves this machine.
#   rules    - no language model at all. Keyword routing to the same tools with
#              templated answers. Always works; used automatically whenever
#              Ollama is unreachable, so a live demo never fails.
#   disabled - assistant switched off.
AI_PROVIDER=ollama

# Where Ollama is listening. The default is correct for a normal install.
OLLAMA_HOST=http://localhost:11434

# Leave blank to auto-pick the best installed model that supports tool calling.
# Set it explicitly to pin one, e.g. OLLAMA_MODEL=qwen2.5
# Install a model first:  ollama pull qwen2.5
OLLAMA_MODEL=

# How many tool-calling rounds the agent may take before it must answer.
AGENT_MAX_STEPS=4

# Seconds to wait for the local model. Small models on CPU can be slow the
# first time, so keep this generous.
AGENT_TIMEOUT_SECONDS=120
